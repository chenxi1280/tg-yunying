name: Prepare Production

'on':
  push:
    branches: [master]
  workflow_dispatch:

permissions:
  contents: read
  packages: write

concurrency:
  group: prepare-production-${{ github.sha }}
  cancel-in-progress: false

env:
  GHCR_NAMESPACE: chenxi1280

jobs:
  validate-preparation:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Validate immutable master source
        env:
          CANDIDATE_REF: ${{ github.ref }}
          CANDIDATE_SHA: ${{ github.sha }}
        run: |
          set -euo pipefail
          test "$CANDIDATE_REF" = refs/heads/master
          test "$(git rev-parse HEAD)" = "$CANDIDATE_SHA"

  backend-no-postgres-checks:
    needs: validate-preparation
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        shard_index: [0, 1, 2, 3, 4, 5]

    services:
      postgres:
        image: postgres:16
        env:
          POSTGRES_USER: tester
          POSTGRES_PASSWORD: tester
          POSTGRES_DB: tg_yunying_test
        ports:
          - 5432:5432
        options: >-
          --health-cmd "pg_isready -U tester -d tg_yunying_test"
          --health-interval 5s
          --health-timeout 5s
          --health-retries 10
      redis:
        image: redis:7
        ports:
          - 6379:6379
        options: >-
          --health-cmd "redis-cli ping"
          --health-interval 5s
          --health-timeout 5s
          --health-retries 10

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.12'
          cache: pip
          cache-dependency-path: backend/pyproject.toml

      - name: Backend checks
        working-directory: backend
        env:
          APP_ENV: test
          TEST_DATABASE_URL: postgresql+psycopg://tester:tester@127.0.0.1:5432/tg_yunying_test?connect_timeout=3
          DATABASE_URL: postgresql+psycopg://tester:tester@127.0.0.1:5432/tg_yunying_test?connect_timeout=3
          REDIS_URL: redis://127.0.0.1:6379/0
          SESSION_SECRET_KEY: ci-session-secret
          ADMIN_BOOTSTRAP_USERNAME: admin
          ADMIN_BOOTSTRAP_PASSWORD: ci-admin-password
          TG_GATEWAY_MODE: mock
          PYTEST_SHARD_INDEX: ${{ matrix.shard_index }}
          PYTEST_SHARD_TOTAL: '6'
        run: |
          set -euo pipefail
          python -m pip install --upgrade pip
          python -m pip install -e '.[dev]'
          python -m compileall -q app
          python -m compileall -q ../.github/scripts
          python -m pytest -q -m no_postgres -p scripts.pytest_shard \
            --durations=50 --durations-min=1.0

  backend-postgres-checks:
    needs: validate-preparation
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        shard_index: [0, 1]

    services:
      postgres:
        image: postgres:16
        env:
          POSTGRES_USER: tester
          POSTGRES_PASSWORD: tester
          POSTGRES_DB: tg_yunying_test
        ports:
          - 5432:5432
        options: >-
          --health-cmd "pg_isready -U tester -d tg_yunying_test"
          --health-interval 5s
          --health-timeout 5s
          --health-retries 10
      redis:
        image: redis:7
        ports:
          - 6379:6379
        options: >-
          --health-cmd "redis-cli ping"
          --health-interval 5s
          --health-timeout 5s
          --health-retries 10

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.12'
          cache: pip
          cache-dependency-path: backend/pyproject.toml

      - name: Backend checks
        working-directory: backend
        env:
          APP_ENV: test
          TEST_DATABASE_URL: postgresql+psycopg://tester:tester@127.0.0.1:5432/tg_yunying_test?connect_timeout=3
          DATABASE_URL: postgresql+psycopg://tester:tester@127.0.0.1:5432/tg_yunying_test?connect_timeout=3
          REDIS_URL: redis://127.0.0.1:6379/0
          SESSION_SECRET_KEY: ci-session-secret
          ADMIN_BOOTSTRAP_USERNAME: admin
          ADMIN_BOOTSTRAP_PASSWORD: ci-admin-password
          TG_GATEWAY_MODE: mock
          PYTEST_SHARD_INDEX: ${{ matrix.shard_index }}
          PYTEST_SHARD_TOTAL: '2'
        run: |
          set -euo pipefail
          python -m pip install --upgrade pip
          python -m pip install -e '.[dev]'
          python -m compileall -q app
          python -m compileall -q ../.github/scripts
          python -m pytest -q -m "not no_postgres" -p scripts.pytest_shard \
            --durations=50 --durations-min=1.0

  frontend-checks:
    needs: validate-preparation
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up Node
        uses: actions/setup-node@v4
        with:
          node-version: '22'
          cache: npm
          cache-dependency-path: frontend/package-lock.json

      - name: Frontend build
        working-directory: frontend
        env:
          VITE_API_BASE: /api
        run: |
          set -euo pipefail
          npm ci
          npm run build

  build-images:
    runs-on: ubuntu-latest
    needs: validate-preparation
    strategy:
      fail-fast: false
      matrix:
        include:
          - image_name: tg-yunying-backend
            dockerfile: Dockerfile.backend
            cache_scope: tgyunying-backend
            build_args: ''
          - image_name: tg-yunying-frontend
            dockerfile: Dockerfile.frontend
            cache_scope: tgyunying-frontend
            build_args: VITE_API_BASE=/api
          - image_name: tg-yunying-image-verification-worker
            dockerfile: Dockerfile.image-verification-worker
            cache_scope: tgyunying-image-verification-worker
            build_args: ''

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3

      - name: Login to GHCR
        uses: docker/login-action@v3
        with:
          registry: ghcr.io
          username: ${{ github.actor }}
          password: ${{ github.token }}

      - name: Build and push ${{ matrix.image_name }} image
        id: build
        uses: docker/build-push-action@v6
        with:
          context: .
          file: ${{ matrix.dockerfile }}
          push: true
          tags: ghcr.io/${{ env.GHCR_NAMESPACE }}/${{ matrix.image_name }}:${{ github.sha }}
          build-args: ${{ matrix.build_args }}
          cache-from: type=gha,scope=${{ matrix.cache_scope }}
          cache-to: type=gha,mode=max,scope=${{ matrix.cache_scope }}

      - name: Record immutable image digest
        env:
          IMAGE_NAME: ${{ matrix.image_name }}
          IMAGE_DIGEST: ${{ steps.build.outputs.digest }}
        run: python3 .github/scripts/prepared_release_manifest.py image --output image-manifests/${{ matrix.image_name }}.json

      - name: Upload image manifest
        uses: actions/upload-artifact@v4
        with:
          name: image-${{ matrix.image_name }}-${{ github.run_attempt }}
          path: image-manifests/${{ matrix.image_name }}.json
          if-no-files-found: error

  prepared-release:
    runs-on: ubuntu-latest
    needs: [backend-no-postgres-checks, backend-postgres-checks, frontend-checks, build-images]
    steps:
      - uses: actions/checkout@v4
      - uses: actions/download-artifact@v4
        with:
          pattern: image-*-${{ github.run_attempt }}
          path: image-manifests
          merge-multiple: true
      - name: Assemble verified release manifest
        run: python3 .github/scripts/prepared_release_manifest.py assemble --output prepared-release.json
      - uses: actions/upload-artifact@v4
        with:
          name: prepared-release-${{ github.sha }}-${{ github.run_attempt }}
          path: prepared-release.json
          if-no-files-found: error

# syntax=docker/dockerfile:1
FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app/backend

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        libgl1 \
        libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY backend/pyproject.toml backend/scripts/install_project_dependencies.py /tmp/dependencies/
RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip install --upgrade pip \
    && python /tmp/dependencies/install_project_dependencies.py \
        /tmp/dependencies/pyproject.toml --extra image-verification-worker

COPY backend/ /app/backend/
RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip install -e . --no-deps --no-build-isolation

USER 65532:65532

CMD ["uvicorn", "app.image_verification_worker_app:app", "--host", "0.0.0.0", "--port", "8091", "--workers", "1"]

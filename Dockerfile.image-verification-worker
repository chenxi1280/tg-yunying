FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app/backend

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        libgl1 \
        libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY backend/ /app/backend/
RUN python -m pip install --upgrade pip \
    && python -m pip install -e '.[image-verification-worker]'

USER 65532:65532

CMD ["uvicorn", "app.image_verification_worker_app:app", "--host", "0.0.0.0", "--port", "8091", "--workers", "1"]

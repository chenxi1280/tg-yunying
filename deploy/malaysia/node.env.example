TG_GATEWAY_MODE=telethon
APP_ENV=production
SESSION_SECRET_KEY=replace-with-node-runtime-secret
ADMIN_BOOTSTRAP_PASSWORD=replace-with-unused-node-runtime-secret
AUTHORIZATION_DR_CONTROL_PLANE_URL=https://replace-with-control-plane
AUTHORIZATION_DR_INTERNAL_TOKEN=replace-with-shared-internal-token
AUTHORIZATION_DR_NODE_ID=my-node-1
AUTHORIZATION_DR_EGRESS_ID=my-egress-1
AUTHORIZATION_DR_EXPECTED_EGRESS_IP=replace-with-malaysia-static-ip
AUTHORIZATION_DR_EGRESS_PROBE_URL=https://api.ipify.org
AUTHORIZATION_DR_CLIENT_CERT=/run/authorization-dr-certs/client.crt
AUTHORIZATION_DR_CLIENT_KEY=/run/authorization-dr-certs/client.key
MY_WAKE_BUNDLE_LOCAL_DIR=/var/lib/tgyunying/wake-local
MY_WAKE_STORAGE_MODE=ssh_mirror
MY_WAKE_SNAPSHOT_PREFIX=tgyunying/authorization-dr
MY_WAKE_SSH_HOST=replace-with-silicon-valley-ip
MY_WAKE_SSH_PORT=22
MY_WAKE_SSH_USER=tgyunying-dr
MY_WAKE_SSH_IDENTITY_FILE=/run/authorization-dr-secrets/id_ed25519
MY_WAKE_SSH_KNOWN_HOSTS_FILE=/run/authorization-dr-secrets/known_hosts
MY_WAKE_SSH_REMOTE_DIR=/data/tgyunying/shared/authorization-dr-snapshots
MY_WAKE_RECOVERY_KEY_FILE=/run/authorization-dr-secrets/recovery.key
# kms_oss mode only:
MY_WAKE_OSS_ENDPOINT=https://oss-ap-southeast-3.aliyuncs.com
MY_WAKE_OSS_BUCKET=replace-with-private-versioned-bucket
MY_WAKE_OSS_PREFIX=tgyunying/authorization-dr
MY_WAKE_OSS_ACCESS_KEY_ID=replace-with-oss-access-key-id
MY_WAKE_OSS_ACCESS_KEY_SECRET=replace-with-oss-access-key-secret
MY_WAKE_KMS_ENDPOINT=kms.ap-southeast-3.aliyuncs.com
MY_WAKE_KMS_REGION_ID=ap-southeast-3
MY_WAKE_KMS_ACCESS_KEY_ID=replace-with-dedicated-kms-access-key-id
MY_WAKE_KMS_ACCESS_KEY_SECRET=replace-with-dedicated-kms-access-key-secret
MY_WAKE_KMS_KEY_ID=replace-with-malaysia-kms-key-id
LOG_LEVEL=INFO

# TG 运营管理平台生产环境模板
# 首次部署会复制到服务器 /data/tgyunying/shared/.env，请在服务器上填写真实值。

APP_ENV=production
TZ=Asia/Shanghai

# Host / Nginx
TGYUNYING_WEB_HOST=tgyunying.example.com
PUBLIC_APP_BASE_URL=https://tgyunying.example.com
TGYUNYING_BACKEND_BIND_HOST=127.0.0.1
TGYUNYING_BACKEND_HOST_PORT=18090
TGYUNYING_FRONTEND_STATIC_BASE_DIR=/data/infra/www/tgyunying.example.com
CORS_ORIGINS=https://tgyunying.example.com

# Shared infra on the Silicon Valley server
INFRA_NETWORK_NAME=infra_default
DATABASE_URL=postgresql+psycopg://tgyunying_app:change-me@infra-postgres:5432/tgyunying?connect_timeout=3
REDIS_URL=redis://infra-redis:6379/3
QUEUE_BACKEND=redis

# Security
SESSION_SECRET_KEY=change-me-to-a-random-64-char-secret
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=change-me-before-first-start
ADMIN_BOOTSTRAP_EMAIL=

# Telegram
TG_GATEWAY_MODE=telethon
TG_API_ID=
TG_API_HASH=
SEED_TG_DEVELOPER_APP_FROM_ENV=false

# Runtime
ENABLE_EMBEDDED_WORKER=false
WORKER_DRAIN_LIMIT=100
WORKER_INTERVAL_SECONDS=2.0
AI_GENERATION_WORKER_DRAIN_LIMIT=20
AI_GENERATION_WORKER_INTERVAL_SECONDS=2.0
ACCOUNT_ONLINE_WORKER_DRAIN_LIMIT=1000
VOICE_PROFILE_WORKER_DRAIN_LIMIT=20
VOICE_PROFILE_WORKER_INTERVAL_SECONDS=2.0
VOICE_PROFILE_RECONCILE_INTERVAL_SECONDS=120
VOICE_PROFILE_RECONCILE_BATCH_LIMIT=100
VOICE_PROFILE_PROVIDER_RATE_PER_MINUTE=30
VOICE_PROFILE_PROVIDER_CONCURRENCY=2
VOICE_PROFILE_PROVIDER_LEASE_SECONDS=120
ACCOUNT_ONLINE_PROBE_CONCURRENCY=32
ACCOUNT_ONLINE_PROBE_TIMEOUT_SECONDS=30
DISPATCHER_SCOPE_CAPACITY=52

# Dispatcher/OCR memory contract. Keep disabled until callback and memory
# canaries have supplied every non-zero budget below.
IMAGE_VERIFICATION_CONTRACT_ENABLED=false
IMAGE_VERIFICATION_CONTRACT_VERSION=
IMAGE_VERIFICATION_CALLBACK_ACCEPTANCE_SECONDS=0
IMAGE_VERIFICATION_CALLBACK_HEADROOM_SECONDS=0
IMAGE_VERIFICATION_MODEL_TAIL_BUDGET_SECONDS=0
IMAGE_VERIFICATION_MODEL_TIMEOUT_SECONDS=30
IMAGE_VERIFICATION_REASONING_RETRY_MIN_BUDGET_SECONDS=0
IMAGE_VERIFICATION_MODEL_CONCURRENCY=20
IMAGE_VERIFICATION_OCR_BACKEND=local
IMAGE_VERIFICATION_WORKER_URL=http://image-verification-worker:8091
IMAGE_VERIFICATION_WORKER_TOKEN=
DISPATCHER_RECYCLE_ENABLED=false
DISPATCHER_RECYCLE_SOFT_RSS_BYTES=0
DISPATCHER_RECYCLE_SOFT_CGROUP_BYTES=0
DISPATCHER_RECYCLE_OCR_ATTEMPT_LIMIT=0
DISPATCHER_RECYCLE_MAX_UPTIME_SECONDS=0
DISPATCHER_RECYCLE_LEASE_SECONDS=0
DISPATCHER_GATEWAY_SHUTDOWN_TIMEOUT_SECONDS=0
DISPATCHER_MEMORY_LIMIT=
DISPATCHER_STOP_GRACE_PERIOD=

# Required only when the enabled contract uses remote OCR.
# Release Actions writes the immutable image reference to `.image.env`.
TGYUNYING_IMAGE_VERIFICATION_IMAGE=
IMAGE_VERIFICATION_MAX_IMAGE_BYTES=0
IMAGE_VERIFICATION_MAX_IMAGE_PIXELS=0
IMAGE_VERIFICATION_MAX_IMAGE_DIMENSION=0
IMAGE_VERIFICATION_WORKER_MAX_BUDGET_SECONDS=0
IMAGE_VERIFICATION_RECOVERY_OBSERVATION_SECONDS=0
IMAGE_VERIFICATION_TERMINAL_TTL_SECONDS=0
IMAGE_VERIFICATION_WORKER_RECYCLE_REQUEST_LIMIT=0
IMAGE_VERIFICATION_WORKER_SOFT_RSS_BYTES=0
IMAGE_VERIFICATION_WORKER_MEMORY_LIMIT=
IMAGE_VERIFICATION_WORKER_STOP_GRACE_PERIOD=
RUNTIME_DETAIL_RETENTION_DAYS=5
RUNTIME_DETAIL_RETENTION_BATCH_SIZE=2000
RUNTIME_DETAIL_CLEANUP_INTERVAL_SECONDS=60
RUNTIME_METRIC_RETENTION_DAYS=3
RUNTIME_METRIC_RETENTION_BATCH_SIZE=20000
RUNTIME_METRIC_CLEANUP_INTERVAL_SECONDS=300
AUTO_MIGRATE_ON_START=false
SEED_DEMO_DATA=false

# Legacy compatibility switches, keep disabled unless doing a migration drill.
ENABLE_LEGACY_CAMPAIGN_WORKER=false
ENABLE_LEGACY_OPERATION_TASK_WORKER=false
ENABLE_LEGACY_CAMPAIGN_ROUTES=false
ENABLE_LEGACY_OPERATION_TASK_ROUTES=false
ENABLE_LEGACY_REVIEW_ROUTES=false

# Post deploy checks
POST_DEPLOY_CHECKS_ENABLED=true
TGYUNYING_CHECK_HOST_NGINX=true
TGYUNYING_CHECK_PUBLIC_URLS=true
TGYUNYING_CHECK_ATTEMPTS=12
TGYUNYING_CHECK_RETRY_DELAY_SECONDS=5
